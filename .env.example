# ─────────────────────────────────────────────
# 이메일 발송 설정 (Gmail App Password 방식)
# ─────────────────────────────────────────────
# 1) Gmail → 계정 설정 → 보안 → 2단계 인증 활성화
# 2) 앱 비밀번호 생성 후 SMTP_PASSWORD에 입력
# ─────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16digit_app_password

# 수신자 목록 (쉼표로 구분)
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# 발신자 표시 이름
EMAIL_SENDER_NAME=뉴스레이더 자동발송

# ─────────────────────────────────────────────
# Ollama 설정 (선택)
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3
